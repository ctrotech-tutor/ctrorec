{
  "name": "@ctrorec/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "backup:create": "node dist/scripts/backup.js create",
    "backup:restore-drill": "node dist/scripts/backup.js restore-drill"
  },
  "dependencies": {
    "@ctrorec/database": "workspace:*",
    "@ctrorec/media": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "drizzle-orm": "0.45.4",
    "nodemailer": "10.3.1",
    "pg-boss": "12.38.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@swc/core": "1.16.20",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
