NODE_ENV=development

API_HOST=0.0.0.0
API_PORT=3001
API_DOCS_ENABLED=true
# Server-only upstream for the Vite development proxy and Start production route.
API_PROXY_TARGET=http://127.0.0.1:3001
# Exact browser origin trusted for CORS and credentialed writes.
WEB_ORIGIN=http://localhost:3000
# Keep true for HTTPS. Use false only for explicit local plain-HTTP testing.
AUTH_COOKIE_SECURE=true
# Set exact trusted hops only when direct API access is network-restricted.
API_TRUST_PROXY_HOPS=0

# Development/test filesystem adapter; keep both paths outside public assets.
AUDIO_STORAGE_PROVIDER=local
AUDIO_STORAGE_ROOT=../../.data/audio
AUDIO_UPLOAD_TEMP_DIR=../../.data/uploads
AUDIO_MAX_UPLOAD_BYTES=268435456
AUDIO_UPLOAD_CHUNK_BYTES=4194304
AUDIO_UPLOAD_SESSION_TTL_MS=86400000

# Optional provider evidence only. Select cloudinary in both API and worker,
# use an isolated folder, and never commit the credential URL.
CLOUDINARY_FOLDER=ctrorec-development
# CLOUDINARY_URL=cloudinary://api-key:api-secret@cloud-name

# Worker-only derivative processing; no HTTP request invokes FFmpeg.
FFMPEG_BIN=ffmpeg
MEDIA_TEMP_DIR=../../.data/processing
MEDIA_PROCESSING_TIMEOUT_MS=1800000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ctrorec
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ctrorec_test
QUEUE_SCHEMA=pgboss
